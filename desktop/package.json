{
  "name": "all-mind-desktop",
  "productName": "All-Mind",
  "version": "1.4.0",
  "private": true,
  "description": "Summarizes whatever is on your screen, in a floating overlay, using Claude.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --win --x64",
    "pack:linux": "npm run build && electron-builder --linux --x64"
  },
  "build": {
    "appId": "com.allmind.desktop",
    "productName": "All-Mind",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/sherpa-onnx-linux-*/**",
      "!node_modules/sherpa-onnx-darwin-*/**",
      "!node_modules/sherpa-onnx-win-ia32/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName} Setup ${version}.${ext}",
      "shortcutName": "All-Mind",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "dir"
      ]
    },
    "forceCodeSigning": false,
    "asarUnpack": [
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-win-x64/**"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/oxanium": "^5.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3"
  },
  "dependencies": {
    "sherpa-onnx-node": "^1.13.8",
    "tar": "^7.5.22",
    "unbzip2-stream": "^1.4.3"
  }
}
